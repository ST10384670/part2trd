<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/txtTitle"
        android:text="Analytics Dashboard"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- TOTAL EXPENSES -->
    <TextView
        android:id="@+id/txtTotalExpenses"
        android:text="Total Expenses: R5000"
        android:textSize="18sp"
        android:layout_marginTop="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- PROGRESS VISUAL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Budget Usage"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>

    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:progress="65"
        android:max="100"
        style="?android:attr/progressBarStyleHorizontal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="65% of budget used"
        android:layout_marginBottom="10dp"/>

    <!-- TOP CATEGORY -->
    <TextView
        android:id="@+id/txtTopCategory"
        android:text="Top Category: Food"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- EXTRA INSIGHT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Insight: Most of your spending goes to food. Consider setting a monthly food budget to improve savings."
        android:padding="12dp"
        android:layout_marginTop="20dp"
        android:background="#EEEEEE"/>

</LinearLayout>